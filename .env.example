# --- Local dev (npm run dev) ---
# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment_practice

# --- docker-compose deploy only (docker-compose.yml, Caddyfile) ---
# Password for the Postgres container's "app" user — compose builds
# DATABASE_URL from this itself, so it's not needed above in that setup.
POSTGRES_PASSWORD=
# Domain Caddy requests a TLS certificate for, e.g. practice.example.com
# (must already point at this VPS's IP).
DOMAIN=

# Random string, 32+ characters — used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First-run login credentials. Only read by `npm run db:seed` the first time
# it creates the user row — change the password afterwards from the app.
BOOTSTRAP_EMAIL=me@example.com
BOOTSTRAP_PASSWORD=

# LLM provider selection (lib/llm/provider.ts). Only "anthropic" exists so far.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5-5
ANTHROPIC_MODEL=
